{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DeadSoulf/home-ai-core_modules/schemas/catalog-v1.schema.json",
  "title": "HOME AI Core official module catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "generated_at",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "upstreams": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "provider",
          "repository",
          "image_repository"
        ],
        "properties": {
          "id": {
            "const": "frigate.module"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "provider": {
            "const": "github-ghcr-official"
          },
          "repository": {
            "const": "blakeblackshear/frigate"
          },
          "image_repository": {
            "const": "ghcr.io/blakeblackshear/frigate"
          }
        }
      }
    }
  }
}
